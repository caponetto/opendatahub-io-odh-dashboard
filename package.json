{
  "name": "odh-dashboard",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opendatahub-io/odh-dashboard.git"
  },
  "homepage": "https://github.com/opendatahub-io/odh-dashboard#readme",
  "bugs": {
    "url": "https://github.com/opendatahub-io/odh-dashboard/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "packages/*/frontend"
  ],
  "scripts": {
    "build": "run-p -l build:*",
    "build:all": "turbo run build",
    "build:backend": "npm run build --prefix packages/dashboard-config && npm run build --prefix packages/dashboard-shell-backend",
    "build:frontend": "npm run build --prefix packages/dashboard-dist-full",
    "build:slim": "npm run build --prefix packages/dashboard-dist-slim",
    "dev": "run-p -l dev:full:backend dev:full:frontend",
    "dev:full:backend": "cd ./packages/dashboard-dist-full && npm run start:dev:backend",
    "dev:full:frontend": "cd ./packages/dashboard-dist-full && npm run start:dev",
    "dev:slim": "run-p -l dev:slim:backend dev:slim:frontend",
    "dev:slim:backend": "cd ./packages/dashboard-dist-slim && npm run start:dev:backend",
    "dev:slim:frontend": "cd ./packages/dashboard-dist-slim && npm run start:dev",
    "format": "prettier --write \"packages/**/*.ts\" \"packages/**/*.tsx\"",
    "make": "make",
    "make:build": "make build",
    "make:deploy": "make deploy",
    "make:login": "make login",
    "make:undeploy": "make undeploy",
    "make:push": "make push",
    "start": "run-p start:*",
    "start:backend": "cd ./packages/dashboard-shell-backend && npm start",
    "start:frontend": "echo \"...available at ./packages/dashboard-dist-full/public\"",
    "test": "run-s test:unit",
    "test:unit": "turbo run test:unit",
    "test:cypress-ci": "cd ./packages/dashboard-dist-full && npm run test:cypress-ci -- ",
    "test:cypress-ci:coverage": "cd ./packages/dashboard-dist-full && npm run test:cypress-ci:coverage -- ",
    "commit:skip-lint-hook": "SKIP_LINT_HOOK=true git commit",
    "commit:force-lint-hook": "FORCE_LINT_HOOK=true git commit",
    "prepare": "husky",
    "validate:ports": "node scripts/validate-module-ports.js",
    "validate:tiers": "node packages/eslint-config/validate-tiers.js",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test-unit": "turbo run test-unit",
    "test-unit-coverage": "turbo run test-unit-coverage && node scripts/unit-test-coverage-aggregator.js",
    "test:contract": "turbo run test:contract --concurrency=1",
    "cypress:server": "turbo run cypress:server",
    "cypress:server:dev": "turbo run cypress:server:dev",
    "cypress:server:build": "turbo run cypress:server:build",
    "cypress:server:build:coverage": "turbo run cypress:server:build:coverage",
    "postinstall": "turbo run install:module --ui=stream",
    "test-e2e:dev": "concurrently --hide=0 -k -s first \"turbo run start:dev\" \"turbo run start:dev:wait && npm run run:e2e -w @odh-dashboard/cypress\"",
    "start:dev": "turbo run start:dev",
    "start:dev:ext": "cd ./packages/dashboard-dist-full && npm run start:dev:ext",
    "start:dev:slim:ext": "cd ./packages/dashboard-dist-slim && npm run start:dev:ext"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.12.2",
    "@types/tar": "^6.1.13",
    "jsonpath-plus": "^10.3.0",
    "tough-cookie": "^4.1.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "babel-plugin-transform-imports": "^2.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "npm-run-all": "^4.1.5",
    "turbo": "^2.4.2"
  },
  "overrides": {
    "@patternfly/react-topology": {
      "react": "^18.2.0"
    },
    "react-router": "^7.6.2",
    "ws": "^8.18.1",
    "dompurify": "^3.2.4",
    "@types/tar": "^6.1.13",
    "jsonpath-plus": "^10.3.0",
    "tough-cookie": "^4.1.3",
    "redux": "^4.2.0",
    "form-data": "^4.0.4",
    "axios": "^1.15.0",
    "@types/node": "^18.14.5"
  }
}
