frontend/public

.github/
.vscode/
.idea/
tests/
**/__mocks__/
**/__tests__/
scripts/
!scripts/prepare-production-manifest.js
manifests/

**/.env.development
**/.env.test

**/.git
**/.gitignore

# Exclude all heavy subdirectories inside workspace packages by default.
# The core dashboard Dockerfile only needs package.json files for workspace resolution
# (plus packages/model-registry/upstream/ for the frontend build).
packages/*/frontend/
packages/*/bff/
packages/*/upstream/
packages/*/node_modules/
packages/*/dist/
packages/*/contract-tests/

# Re-include what Dockerfile.workspace plugin builds need.
# model-registry (core dashboard build + plugin build)
!packages/model-registry/upstream/
# maas plugin build
!packages/maas/frontend/
!packages/maas/bff/
# Workspace deps copied by maas/Dockerfile.workspace
!packages/llmd-serving/
!packages/model-serving/
!packages/kserve/

.editorconfig
.prettierrc
**/.prettierignore
**/.eslintignore
**/.eslintrc
Makefile
OWNERS
**/README.md
