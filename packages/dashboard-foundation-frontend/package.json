{
  "name": "@odh-dashboard/dashboard-foundation-frontend",
  "version": "0.0.0",
  "private": true,
  "sideEffects": ["*.css", "*.scss"],
  "topology": {
    "tier": "infrastructure"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test-unit": "jest --silent",
    "test-unit-coverage": "jest --silent --coverage"
  },
  "imports": {
    "#~/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./concepts/areas": "./src/concepts/areas/index.ts",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@odh-dashboard/dashboard-config": "*",
    "@odh-dashboard/k8s-browser": "*",
    "@odh-dashboard/plugin-types": "*",
    "@patternfly/quickstarts": "*",
    "@patternfly/react-code-editor": "*",
    "@patternfly/react-core": "*",
    "@patternfly/react-icons": "*",
    "@patternfly/react-log-viewer": "^6.4.0-prerelease.1",
    "@patternfly/react-styles": "*",
    "@patternfly/react-table": "^6.4.1",
    "@patternfly/react-tokens": "*",
    "@segment/analytics-next": "^1.72.0",
    "axios": "*",
    "classnames": "^2.2.6",
    "compare-versions": "*",
    "dompurify": "^3.2.4",
    "lodash-es": "*",
    "monaco-editor": "*",
    "react": "^18.2.0",
    "react-cool-dimensions": "^2.0.5",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^10.1.0",
    "react-redux": "^8.0.4",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2",
    "redux": "^4.2.0",
    "redux-thunk": "^2.4.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-gfm": "^4.0.1",
    "showdown": "^2.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/test-mocks": "*",
    "@odh-dashboard/tsconfig": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "react-dom": "^18.2.0",
    "@types/classnames": "^2.3.1",
    "@types/dompurify": "^2.2.6",
    "@types/lodash-es": "^4.17.8",
    "@types/showdown": "^2.0.3"
  }
}
