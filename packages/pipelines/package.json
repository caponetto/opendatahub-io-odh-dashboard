    "fastify-plugin": "^4.5.1",
    "google-protobuf": "^3.11.2",
    "grpc-web": "^1.2.1",
    "react": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-router": "^7.6.2",
