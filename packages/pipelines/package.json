{
  "private": true,
  "name": "@odh-dashboard/pipelines",
  "description": "Pipelines feature plugin",
  "version": "0.0.0",
  "topology": {
    "tier": "extension"
  },
  "scripts": {
    "build:backend": "rimraf dist/backend && tsc -p tsconfig.backend.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test-unit": "jest --silent"
  },
  "imports": {
    "#~/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./extensions": "./src/extensions.ts",
    "./extension-points": "./extension-points/index.ts",
    "./routes": "./dist/backend/routes/index.js",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@fastify/autoload": "^5.7.1",
