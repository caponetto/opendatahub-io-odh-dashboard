{
  "private": true,
  "name": "@odh-dashboard/trustyai",
  "description": "TrustyAI feature plugin",
  "version": "0.0.0",
  "topology": {
    "tier": "extension"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test-unit": "jest --silent --passWithNoTests"
  },
  "exports": {
    "./extensions": "./src/extensions.ts",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@odh-dashboard/dashboard-foundation-frontend": "*",
    "@odh-dashboard/k8s-browser": "*",
    "@odh-dashboard/model-serving-shared": "*",
    "@odh-dashboard/plugin-core": "*",
    "@patternfly/react-core": "*",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/tsconfig": "*",
    "@types/react": "*"
  }
}
