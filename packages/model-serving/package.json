{
  "private": true,
  "name": "@odh-dashboard/model-serving",
  "description": "Plugin to display model deployments. Used in combination with specific model serving platform extensions.",
  "version": "0.0.0",
  "sideEffects": ["*.css", "*.scss"],
  "topology": {
    "tier": "extension"
  },
  "scripts": {
    "build:backend": "rimraf dist/backend && tsc -p tsconfig.backend.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:fix": "eslint --ext .js,.ts,.jsx,.tsx . --fix",
    "test-unit": "jest --silent",
    "test-unit-coverage": "jest --silent --coverage",
    "type-check": "tsc --noEmit"
  },
  "exports": {
    "./routes": "./dist/backend/routes/index.js",
    "./extensions": "./src/extensions/index.ts",
    "./components/*": [
      "./src/components/*",
      "./src/components/*.ts",
      "./src/components/*.d.ts",
      "./src/components/*.tsx"
    ],
    "./concepts/auth": "./src/concepts/auth.ts",
    "./concepts/useModelServingClusterSettings": "./src/concepts/useModelServingClusterSettings.tsx",
    "./utils": "./src/concepts/utils.ts",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@fastify/autoload": "^5.7.1",
    "@kubernetes/client-node": "^0.12.2",
    "@odh-dashboard/connection-types-shared": "*",
    "@odh-dashboard/dashboard-foundation-backend": "*",
    "@odh-dashboard/dashboard-foundation-frontend": "*",
    "@odh-dashboard/distributed-workloads-shared": "*",
    "@odh-dashboard/hardware-profiles-shared": "*",
    "@odh-dashboard/k8s-browser": "*",
    "@odh-dashboard/projects-shared": "*",
    "@odh-dashboard/model-serving-shared": "*",
    "@odh-dashboard/plugin-core": "*",
    "@odh-dashboard/storage-classes-shared": "*",
    "@patternfly/react-charts": "^8.4.0",
    "@patternfly/react-code-editor": "*",
    "@patternfly/react-core": "*",
    "@patternfly/react-icons": "*",
    "@patternfly/react-styles": "*",
    "@patternfly/react-table": "*",
    "@patternfly/react-templates": "*",
    "axios": "*",
    "fastify": "^4.23.2",
    "fastify-plugin": "^4.5.1",
    "http-errors": "^1.8.0",
    "lodash": "^4.17.21",
    "lodash-es": "*",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2",
    "victory-area": "^37.3.6",
    "victory-axis": "^37.3.6",
    "victory-bar": "^37.3.6",
    "victory-box-plot": "^37.3.6",
    "victory-chart": "^37.3.6",
    "victory-core": "^37.3.6",
    "victory-create-container": "^37.3.6",
    "victory-cursor-container": "^37.3.6",
    "victory-group": "^37.3.6",
    "victory-legend": "^37.3.6",
    "victory-line": "^37.3.6",
    "victory-pie": "^37.3.6",
    "victory-scatter": "^37.3.6",
    "victory-stack": "^37.3.6",
    "victory-tooltip": "^37.3.6",
    "victory-voronoi-container": "^37.3.6",
    "victory-zoom-container": "^37.3.6",
    "yaml": "^2.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/test-mocks": "*",
    "@odh-dashboard/tsconfig": "*",
    "@testing-library/dom": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "16.3.0",
    "@types/lodash-es": "^4.17.8",
    "@types/node": "^18.14.5",
    "@types/react": "*",
    "react-dom": "^18.2.0"
  }
}
