{
  "private": true,
  "name": "@odh-dashboard/plugin-core",
  "description": "Plugin utilities and extension point definitions.",
  "version": "0.0.0",
  "sideEffects": false,
  "topology": {
    "tier": "infrastructure"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test-unit": "jest --silent",
    "test-unit-coverage": "jest --silent --coverage",
    "type-check": "tsc --noEmit"
