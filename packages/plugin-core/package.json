    "./extension-points": "./src/extension-points/index.ts",
    "./testing": "./src/testing/utils.ts"
  },
  "dependencies": {
    "@odh-dashboard/dashboard-foundation-frontend": "*",
    "@odh-dashboard/plugin-types": "*",
    "lodash-es": "*"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/tsconfig": "*",
    "@testing-library/react": "16.3.0",
    "react-dom": "^18.2.0",
    "@types/lodash-es": "^4.17.8"
  }
}
