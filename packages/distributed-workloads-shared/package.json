{
  "private": true,
  "name": "@odh-dashboard/distributed-workloads-shared",
  "description": "Shared distributed workload and Kueue types, hooks, and utilities consumed by multiple extensions",
  "version": "0.0.0",
  "sideEffects": false,
  "topology": {
    "tier": "shared"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test-unit": "jest --silent"
  },
  "imports": {
    "#~/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@odh-dashboard/dashboard-foundation-frontend": "*",
    "@odh-dashboard/k8s-browser": "*",
    "@odh-dashboard/plugin-core": "*",
    "@patternfly/react-core": "*",
    "@patternfly/react-icons": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/test-mocks": "*",
    "@odh-dashboard/tsconfig": "*",
    "@types/react": "*"
  }
}
