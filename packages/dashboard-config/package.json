{
  "private": true,
  "name": "@odh-dashboard/dashboard-config",
  "description": "Configuration and utilities for application",
  "version": "0.0.0",
  "bin": {
    "package-subtree": "./scripts/package-subtree.sh"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "topology": {
    "tier": "infrastructure",
    "eslintTierExempt": true
  },
  "dependencies": {
    "@odh-dashboard/dashboard-build": "*"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.prod.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test-unit": "jest --silent",
    "test-unit-coverage": "jest --silent --coverage",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/tsconfig": "*"
  }
}
