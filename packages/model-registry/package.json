{
  "private": true,
  "name": "@odh-dashboard/model-registry",
  "description": "Model registry plugin.",
  "version": "0.0.0",
  "topology": {
    "tier": "extension"
  },
  "scripts": {
    "build": "make -C upstream build",
    "build:backend": "rimraf dist/backend && tsc -p tsconfig.backend.json",
    "install:module": "npm install --prefix upstream/frontend",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "update-subtree": "package-subtree --package=@odh-dashboard/model-registry",
    "test:contract": "odh-ct-bff-consumer --bff-dir upstream/bff",
    "cypress:server:build": "cd upstream/frontend && cross-env DIST_DIR=./public-cypress POLL_INTERVAL=9999999 DEPLOYMENT_MODE=federated npm run build",
    "cypress:server:build:coverage": "cross-env COVERAGE=true npm run cypress:server:build",
    "cypress:server": "cd upstream/frontend && serve ./public-cypress -p 9100 -s -L",
    "cypress:server:dev": "cd upstream/frontend && cross-env DEPLOYMENT_MODE=federated PORT=9100 PROXY_PORT=4000 npm run start:dev",
    "cypress:server:wait": "npx wait-on -i 1000 http://localhost:9100",
    "start:dev": "cd upstream && cross-env PORT=9100 make dev-start-federated",
    "start:dev:ext": "cd upstream/frontend && cross-env DEPLOYMENT_MODE=federated PORT=9100 npm run start:dev",
    "start:dev:wait": "npx wait-on -i 1000 http://localhost:9100"
  },
  "subtree": {
    "repo": "https://github.com/kubeflow/model-registry.git",
    "branch": "main",
    "src": "clients/ui",
    "target": "upstream",
    "commit": "6eb25cfb3ce76cd0f87438ea7de60b414dd6e25a"
  },
  "module-federation": {
    "name": "modelRegistry",
    "remoteEntry": "/remoteEntry.js",
    "authorize": true,
    "tls": false,
    "proxy": [
      {
        "path": "/model-registry/api",
        "pathRewrite": "/api"
      }
    ],
    "local": {
      "host": "localhost",
      "port": 9100
    },
    "service": {
      "name": "odh-dashboard",
      "port": 8043
    }
  },
  "e2eCiTags": [
    "@ModelRegistryCI"
  ],
  "bffConfig": {
    "enabled": true,
    "port": 4000,
    "healthEndpoint": "/healthcheck",
    "startCommand": "make -C upstream dev-bff-e2e-mock",
    "startCommandCluster": "make -C upstream dev-bff-e2e-cluster"
  },
  "exports": {
    "./routes": "./dist/backend/routes/index.js",
    "./extensions": "./src/extensions.ts",
    "./model-catalog-deploy": {
      "types": "./upstream/frontend/src/odh/extension-points/model-catalog-deploy.ts"
    },
    "./mocks/*": [
      "./upstream/frontend/src/__mocks__/*",
      "./upstream/frontend/src/__mocks__/*.ts"
    ],
    "./types/modelCatalogTypes": "./upstream/frontend/src/app/modelCatalogTypes.ts",
    "./types/mcpDeploymentTypes": "./upstream/frontend/src/app/mcpDeploymentTypes.ts",
    "./types/types": "./upstream/frontend/src/app/types.ts",
    "./routeUtils": "./upstream/frontend/src/app/pages/modelRegistry/screens/routeUtils.ts",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@fastify/autoload": "^5.7.1",
    "@kubernetes/client-node": "^0.12.2",
    "@odh-dashboard/connection-types-shared": "*",
    "@odh-dashboard/dashboard-foundation-backend": "*",
    "@odh-dashboard/dashboard-foundation-frontend": "*",
    "@odh-dashboard/k8s-browser": "*",
    "@odh-dashboard/model-serving-shared": "*",
    "@patternfly/react-core": "*",
    "@patternfly/react-icons": "*",
    "@patternfly/react-table": "*",
    "fastify": "^4.23.2",
    "fastify-plugin": "^4.5.1",
    "http-errors": "^1.8.0",
    "lodash-es": "^4.17.15",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@odh-dashboard/contract-tests": "*",
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/plugin-core": "*",
    "@odh-dashboard/test-mocks": "*",
    "@odh-dashboard/tsconfig": "*",
    "@patternfly/react-code-editor": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "*",
    "@types/react": "*",
    "cross-env": "^10.1.0",
    "react-dom": "^18.2.0"
  }
}
