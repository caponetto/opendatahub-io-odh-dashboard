{
  "private": true,
  "name": "@odh-dashboard/workbench-images",
  "description": "Workbench Images (BYON) admin page for managing custom notebook images",
  "version": "0.0.0",
  "topology": {
    "tier": "extension"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test-unit": "jest --silent"
  },
  "exports": {
    "./extensions": "./src/extensions.ts",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@odh-dashboard/dashboard-foundation-frontend": "*",
    "@odh-dashboard/hardware-profiles-shared": "*",
    "@odh-dashboard/k8s-browser": "*",
    "@odh-dashboard/plugin-core": "*",
    "@patternfly/react-core": "*",
    "@patternfly/react-icons": "*",
    "@patternfly/react-table": "*",
    "react": "^18.2.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/test-mocks": "*",
    "@odh-dashboard/tsconfig": "*",
    "@types/react": "*"
  }
}
