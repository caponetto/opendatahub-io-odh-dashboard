{
  "private": true,
  "name": "@odh-dashboard/notebook-controller",
  "description": "Notebook Controller feature plugin",
  "version": "0.0.0",
  "topology": {
    "tier": "extension"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test-unit": "jest --silent"
  },
  "imports": {
    "#~/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./extensions": "./src/extensions.ts",
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.d.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@odh-dashboard/connection-types-shared": "*",
    "@odh-dashboard/dashboard-foundation-frontend": "*",
    "@odh-dashboard/workbenches-shared": "*",
    "@odh-dashboard/distributed-workloads-shared": "*",
    "@odh-dashboard/hardware-profiles-shared": "*",
    "@odh-dashboard/k8s-browser": "*",
    "@odh-dashboard/plugin-core": "*",
    "@odh-dashboard/storage-classes-shared": "*",
    "@patternfly/react-core": "*",
    "@patternfly/react-icons": "*",
    "@patternfly/react-table": "*",
    "axios": "*",
    "lodash-es": "*",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/test-mocks": "*",
    "@odh-dashboard/tsconfig": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@types/lodash-es": "^4.17.8",
    "@types/react": "*",
    "react-dom": "^18.2.0"
  }
}
